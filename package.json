{
  "name": "@lzwme/git-helper",
  "version": "1.7.3",
  "description": "一个简单的 git 提交等操作的辅助小工具",
  "main": "esm/index.js",
  "browser": "esm/index.js",
  "typings": "esm/index.d.ts",
  "type": "module",
  "bin": {
    "githelper": "bin/githelper.js",
    "g": "bin/githelper.js"
  },
  "repository": "https://github.com/lzwme/git-helper.git",
  "author": {
    "name": "renxia",
    "email": "lzwy0820@qq.com",
    "url": "https://lzw.me"
  },
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=14.18"
  },
  "keywords": [
    "git",
    "git helper",
    "git commit"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "npm run watch:build",
    "start": "npm run watch",
    "build": "run-s clean && run-p build:*",
    "build:esm": "tsc -p tsconfig.module.json",
    "lint": "npm run check:tsc && npm run fix",
    "check:tsc": "tsc --noEmit",
    "check": "biome check src/ scripts/ bin/",
    "fix": "biome check --write src/ scripts/ bin/",
    "test": "run-s test:*",
    "test:lint": "biome check src/ scripts/ bin/",
    "test:unit": "vitest run",
    "watch": "run-s clean && run-p \"watch:build\" \"watch:test\"",
    "watch:build": "npm run build:esm -- -w",
    "watch:test": "vitest --watch",
    "cov": "vitest run --coverage",
    "doc": "typedoc src/ --exclude **/*.spec.ts --out docs",
    "version": "standard-version",
    "prepare-release": "run-s build test doc version",
    "release": "run-s test build doc",
    "clean": "node scripts/rmdir.js ./esm ./docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@lzwme/fed-lint-helper": "^2.6.6",
    "@types/node": "^24.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all": "^4.1.5",
    "standard-version": "^9.5.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@lzwme/fe-utils": "^1.9.2",
    "commander": "^15.0.0",
    "console-log-colors": "^0.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
